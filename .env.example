# Gapless SRT Pusher -- operator control panel (CFG-01)
#
# Copy this file to `.env` and edit the values for your church's deployment.
# `.env` is gitignored and MUST NEVER be committed -- it is the only place a
# real SRT relay target or passphrase should ever live (CFG-03).
#
# Every key below has a safe code-level default; `.env` only OVERRIDES the
# defaults you actually need to change. Internal, empirically-tuned safety
# constants (e.g. resume-margin bytes, backoff timings) are deliberately NOT
# exposed here -- they stay code-only to protect the gapless guarantee.
# Key names below match lib/Config.psm1's schema table exactly -- an operator
# override only takes effect if the name matches character-for-character.

# Local path or UNC only to the OBS recording folder (SYSTEM account cannot
# see mapped drives -- do not use a mapped drive letter here)
RECORDING_FOLDER_PATH=state/

# OBS output filename pattern to watch inside RECORDING_FOLDER_PATH
RECORDING_FILENAME_GLOB=*.ts

# SRT relay target host (the VPS relay's listener address)
RELAY_HOST=127.0.0.1

# SRT relay target port (1-65535)
RELAY_PORT=8890

# SRT streamid -- identifies this church/stream to the relay
STREAM_ID=church-01

# SRT latency, in MICROSECONDS (not milliseconds) -- raise for higher-RTT
# or lossier WANs; ~2.5x the pusher<->relay round-trip time is a starting point
LATENCY_MICROSECONDS=500000

# Catch-up send-rate cap, as a multiplier of the observed recording growth
# rate -- keep near the lower end (1.5-2.0x) so bonded WANs are not congested
CATCH_UP_MULTIPLIER=1.5

# Seconds to smooth the growth-rate estimate feeding the dashboard delay/bitrate
# and the pacing/catch-up cap -- larger = steadier dashboard numbers and pacing.
# Set <=0 to disable smoothing and restore the raw (jitterier) prior behavior.
GROWTH_RATE_SMOOTHING_SECONDS=30

# OBS process name used for the end-of-service liveness check
OBS_PROCESS_NAME=obs64

# Seconds the recording file must stop growing (with OBS still running)
# before the pusher treats it as end-of-service rather than a network outage
GROWTH_STALL_SUSTAINED_WINDOW_SECONDS=30

# Log rotation: active pusher.log is rotated once it exceeds this many bytes
# (default 10485760 = 10 MB)
LOG_MAX_SIZE_BYTES=10485760

# Log rotation: number of rotated log files to retain (pusher.log.1 .. .N)
# before the oldest is deleted
LOG_RETENTION_COUNT=5

# Reserved for the Phase 5 dashboard (documented now, not consumed until then)
DASHBOARD_PORT=8787

# How recently the persisted recording must have been written to still be trusted
# as the current session; older than this on Start = prior session, start fresh.
# Default 1800 = 30 min. SESS-01.
SESSION_RESUME_STALE_AFTER_SECONDS=1800

# OPTIONAL local-only secret: SRT AES passphrase for the pusher->relay leg.
# Leave blank unless the relay requires SRT encryption. NEVER commit a real
# value here -- this file ships blank and stays blank in version control.
SRT_PASSPHRASE=

# Enable the optional VPS relay health probe (MON-03). OFF by default -- the
# probe is entirely opt-in. When true, the dashboard reaches reachability +
# latency for the relay above with ZERO extra credentials (reuses RELAY_HOST/
# RELAY_PORT, D-10 -- do not add a duplicate relay address here).
PROBE_VPS_ENABLED=false

# OPTIONAL: SSH host/user/keypath for the VPS probe's process-health leg (is
# the relay's ffmpeg -c copy still alive). Leave all three blank to skip SSH --
# reachability+latency above still works with zero credentials (D-09). These
# hold a host/user and a filesystem PATH to a private key file -- NEVER the
# key material itself and NEVER a password (CFG-03: this repo holds no secrets).
PROBE_VPS_SSH_HOST=
PROBE_VPS_SSH_USER=
PROBE_VPS_SSH_KEYPATH=

# Detect a new recording after a clean finish and auto-start streaming for it
# (default off -- detection/notify only). With AUTO_PICKUP=false (default), a
# strictly-newer recording is still detected and surfaced on the dashboard with
# a one-click Start, but streaming never begins unattended (T-epo-01).
AUTO_PICKUP=false
